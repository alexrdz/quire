{
  "name": "quire",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "check:sizing": "node --import tsx scripts/check-fluid-sizing.ts",
    "check:env": "node --import tsx scripts/check-env.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:fluid": "playwright test --config playwright.fluid.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --import tsx scripts/db-migrate.ts",
    "db:migrate:preview": "node --import tsx scripts/db-migrate.ts --preview",
    "db:migrate:local": "NODE_ENV=development node --import tsx scripts/db-migrate.ts",
    "db:baseline": "node --import tsx scripts/db-baseline.ts",
    "db:studio": "drizzle-kit studio",
    "db:seed": "node --import tsx src/lib/server/seed.ts",
    "admin": "node --import tsx scripts/admin.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.1",
    "@sveltejs/adapter-netlify": "^6.0.4",
    "@sveltejs/kit": "^2.16.1",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@types/node": "^22.13.4",
    "@types/qrcode": "^1.5.5",
    "drizzle-kit": "^0.30.4",
    "svelte": "^5.20.2",
    "svelte-check": "^4.1.4",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.750.0",
    "@aws-sdk/s3-request-presigner": "^3.750.0",
    "@libsql/client": "^0.14.0",
    "better-auth": "^1.1.18",
    "drizzle-orm": "^0.39.3",
    "file-type": "^22.3.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "stripe": "^17.6.0",
    "zod": "^4.0.0"
  }
}
