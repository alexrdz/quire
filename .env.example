# ==============================================================================
# Quire environment variables
# ==============================================================================
# Copy to .env for local work (`cp .env.example .env`). Deployed sites (Netlify)
# set these in the site's environment settings instead.
#
# Every variable that src/lib/server/config.ts, scripts/check-env.ts,
# scripts/db-migrate.ts and drizzle.config.ts read is listed here;
# tests/unit/server/env-example.test.ts fails if this file and the config drift
# apart.
#
# Values are empty on purpose: never put a real secret in this file. In
# development and test every empty value falls back to a safe local default,
# so an empty .env runs the app. Modes (ADR 0007): development, test, demo,
# production. "Deployed" means demo or production.

# ------------------------------------------------------------------------------
# Mode
# ------------------------------------------------------------------------------

# "true" makes this deploy the Demo site: sample data, stand-ins, no real email,
# tip buttons never open Venmo. Leave empty for production and local work.
DEMO_MODE=

# "true" stops the sample data loading on the first request. Development and the
# Demo only; production never auto-seeds.
DISABLE_AUTO_SEED=

# Set by the tooling, not by you: Vite sets NODE_ENV=development for `pnpm dev`,
# Vitest sets VITEST and NODE_ENV=test. Anything else, including unset, is
# production (fails closed). Listed commented out so copying this file never
# overrides them.
# NODE_ENV=
# VITEST=

# ------------------------------------------------------------------------------
# Core: required in demo and production
# ------------------------------------------------------------------------------
# If any core value is missing or invalid in a deployed mode, the site serves a
# 503 page and `pnpm check:env` fails the build. Optional in development and test.

# Turso database URL (libsql://...). Development defaults to file:local.db; tests
# always use the local file database.
DATABASE_URL=

# Turso auth token. Required whenever DATABASE_URL is remote.
DATABASE_AUTH_TOKEN=

# Better Auth signing secret: at least 32 random characters, e.g.
# `openssl rand -hex 32`. Development uses a built-in local secret.
BETTER_AUTH_SECRET=

# HMAC secret for scan tokens, Tip Tap device ids and rate-limit keys: at least
# 32 random characters, and different from BETTER_AUTH_SECRET.
COOKIE_SECRET=

# The site's public origin, e.g. https://quire.live. Printed QR codes, emailed
# links and auth callbacks use it, never the request's Host header.
# Development defaults to http://localhost:5173.
BETTER_AUTH_URL=

# Fallback for BETTER_AUTH_URL, read only when BETTER_AUTH_URL is empty.
PUBLIC_APP_URL=

# The real site's public origin, e.g. https://quire.live. Set it on the Demo site
# only: the Demo banner then links to the real sign-up. Unset: no link.
PUBLIC_PRODUCTION_URL=

# ------------------------------------------------------------------------------
# Migrations: Netlify deploy previews (docs/database-migrations.md)
# ------------------------------------------------------------------------------
# Deploy previews and branch deploys never migrate the production database.
# Unset (the default): their builds skip migrations. To migrate previews, create
# a separate preview database, scope DATABASE_URL and DATABASE_AUTH_TOKEN to it
# for those contexts in Netlify, and set this to the same URL. A value that
# differs from DATABASE_URL fails the build. Never set it for production.
PREVIEW_DATABASE_URL=

# Set by Netlify, not by you: production, deploy-preview or branch-deploy.
# CONTEXT=

# ------------------------------------------------------------------------------
# Features: optional; a missing key switches off only that feature
# ------------------------------------------------------------------------------

# Transactional email (Resend). Unset: development and test log emails to the
# console. Unset in production: everything that sends email is off, which
# includes Artist sign-up, password resets and Venmo/email changes.
# The Demo never sends email, even with a key.
RESEND_API_KEY=
# Sender address. Defaults to "Quire <noreply@quire.live>".
RESEND_FROM_EMAIL=

# Fan Google sign-in for Walls and Stamps. Both are needed. Unset: development,
# test and the Demo sign in as the sample Fan; production Fan sign-in is off.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Media uploads (Cloudflare R2, ADR 0004). The first three are needed. Unset:
# development, test and the Demo store uploads locally; production uploads are off.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Bucket name. Defaults to quire-media.
R2_BUCKET_NAME=
# Public base URL for the bucket, e.g. https://media.quire.live.
R2_PUBLIC_URL=

# ------------------------------------------------------------------------------
# Test only, never set on a deployed site
# ------------------------------------------------------------------------------
# "true" lets the demo and production modes run locally for the e2e suite
# (playwright.config.ts sets it for its Demo- and production-mode servers): a
# file: DATABASE_URL and fixed test secrets are accepted. It applies only when
# DATABASE_URL starts with file: and none of NETLIFY, CONTEXT, DEPLOY_URL or
# SITE_ID is set; otherwise it is ignored (and logged) and the normal rules apply. With a
# remote DATABASE_URL or on Netlify, `pnpm check:env` fails the build.
# Details: docs/e2e-local-preview.md.
QUIRE_E2E_LOCAL_PREVIEW=

# Set by Netlify, not by you. NETLIFY and DEPLOY_URL during builds, SITE_ID
# during builds and in functions. The flag above checks that they are unset,
# and the Demo's upload stand-in is off when any is set (CONTEXT is listed
# under Migrations).
# NETLIFY=
# DEPLOY_URL=
# SITE_ID=

# ------------------------------------------------------------------------------
# Stripe: dormant and optional (ADR 0008), nothing reads them for tips
# ------------------------------------------------------------------------------
# Tips go straight to each Artist's Venmo. The Stripe code is kept but unwired:
# these keys are not required in any mode and are ignored if set.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
