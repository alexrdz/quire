# ==============================================================================
# Quire Production & Local Environment Configuration
# ==============================================================================

# --- Database (Turso / libSQL) ---
# Local development fallback uses SQLite file:local.db
DATABASE_URL=file:local.db
DATABASE_AUTH_TOKEN=

# --- Authentication & Application URLs (Better Auth + Google OAuth) ---
# Generate a strong random secret (>= 32 chars) for production
BETTER_AUTH_SECRET=change_me_to_a_secure_32_char_secret
BETTER_AUTH_URL=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173
COOKIE_SECRET=change_me_to_a_secure_32_char_attendance_hmac_secret

# Google OAuth (required for Fan Sign-In for Walls & Stamps)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Payments (Stripe Connect Express) ---
# Platform secret key (sk_test_... or sk_live_...)
STRIPE_SECRET_KEY=
# Publishable key for client-side Stripe Elements / Apple Pay / Google Pay
STRIPE_PUBLISHABLE_KEY=
# Webhook signing secret from `stripe listen` or Stripe Dashboard (whsec_...)
STRIPE_WEBHOOK_SECRET=

# --- Transactional Email (Resend) ---
# When unset in local dev/test, emails log to server console as a dev fallback.
# When set, real transactional emails are sent via the Resend API.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Quire <noreply@quire.live>

# --- Media Storage (Cloudflare R2) ---
# When unset in local dev, uploads fall back to /static/uploads
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=quire-media
R2_PUBLIC_URL=
